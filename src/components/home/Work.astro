---
interface Project {
  name: string;
  description: string;
  context: string;
  type: string;
  href?: string;
  live?: boolean;
}

const projects: Project[] = [
  {
    name: "TaxMaxi",
    description:
      "Crypto tax reports for Germany. An AI agent, a public API and an MCP server, built on tax rules that have to add up to the cent.",
    context: "Own product",
    type: "Live",
    href: "https://taxmaxi.com",
    live: true,
  },
  {
    name: "Lending platform",
    description:
      "A fintech loan management system with KYC, AML and e-signature integrations, where every step has to be documented.",
    context: "Stryber",
    type: "Fintech",
  },
  {
    name: "Agentic coding",
    description:
      "Led the adoption of AI coding agents in the engineering team of a digital wealth manager.",
    context: "LIQID",
    type: "AI adoption",
  },
  {
    name: "Web3 apps",
    description: "Consumer web3 products that generated more than $1M in revenue.",
    context: "Showtime",
    type: "Consumer",
  },
  {
    name: "Release tooling",
    description: "An internal Kubernetes release tool that handled around 430 releases a month.",
    context: "YNAP",
    type: "Platform",
  },
  {
    name: "Expo Share Extension",
    description:
      "An Expo config plugin for building iOS share extensions with a custom view. 550+ stars on GitHub.",
    context: "Open source",
    type: "Library",
    href: "https://github.com/MaxAst/expo-share-extension",
  },
];
---

<section class="work" id="work">
  <div class="shell">
    <div class="work-head">
      <p class="eyebrow" data-reveal><span>04</span>Selected work</p>
    </div>
    <ol class="index">
      {
        projects.map(({ name, description, context, type, href, live }, i) => {
          // Rows with a link render as anchors; the rest are plain rows without an arrow.
          const Row = href ? "a" : "div";
          return (
            <li data-reveal>
              <Row class:list={["row", { "is-live": live }]} href={href}>
                <span class="row-n">{String(i + 1).padStart(2, "0")}</span>
                <span class="row-name">{name}</span>
                <span class="row-desc">{description}</span>
                <span class="row-ctx">{context}</span>
                <span class="row-type">{type}</span>
                <span class="row-arr" aria-hidden="true">
                  {href && <Fragment set:html="&nearr;" />}
                </span>
              </Row>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
