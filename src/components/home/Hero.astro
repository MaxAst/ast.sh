---
import { MARK_PATH } from "../../lib/brand";
import Logos from "./Logos.astro";

const words = ["correct", "auditable", "compliant", "explainable"];
---

<section class="hero">
  <div class="hero-grid" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
  <svg class="hero-mark" viewBox="90 40 340 400" aria-hidden="true"><path d={MARK_PATH}></path></svg>

  <div class="hero-top shell">
    <span>Independent studio, Berlin</span>
    <span class="hide-sm">Coding agents, MCP and AI products</span>
    <span class="hide-sm">For regulated industries</span>
  </div>

  <div class="shell hero-body">
    <h1 class="hero-title">
      <span class="line"><span>AI made software fast.</span></span>
      <span class="line"><span>Making it <span class="cycle" aria-hidden="true">{words.map((word, i) => <em class:list={{ "is-on": i === 0 }}>{word}</em>)}</span><span class="sr">{words[0]}</span></span></span>
      <span class="line"><span>is the work.</span></span>
    </h1>

    <div class="hero-foot">
      <p class="hero-sub">
        Ast helps teams in tax, finance and other regulated fields build with AI without giving up
        correctness. I set up coding agents, make products agent-ready and ship pilots that hold up
        in an audit.
      </p>
      <a class="hero-live" href="https://taxmaxi.com"
        ><span class="dot"></span>TaxMaxi, my crypto tax product, is live <span class="arr">&rarr;</span></a
      >
    </div>
  </div>

  <Logos />
</section>
