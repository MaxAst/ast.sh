---
const steps = [
  {
    title: "Start from the rules, not the model.",
    body: "Before anything is built, the domain gets written down: the regulation, the edge cases, and what “correct” means in numbers. That becomes the tests, schemas and fixtures that people and agents both work against.",
  },
  {
    title: "Make every step checkable.",
    body: "Everything an agent touches leaves a trail: typed interfaces, deterministic checks and logs you can replay. When someone asks why a number is what it is, there is an answer.",
  },
  {
    title: "Ship small, then let agents carry the load.",
    body: "Small, reviewed increments go to production, and your team owns the result from day one. There's no lock-in and no black box, and you get software, not slide decks.",
  },
];
---

<section class="approach" id="approach">
  <div class="shell">
    <div class="approach-head">
      <p class="eyebrow" data-reveal><span>02</span>Approach</p>
      <h2 class="h-display" data-reveal>Rules first. <em>Then</em> speed.</h2>
    </div>
    <ol class="steps">
      {
        steps.map(({ title, body }, i) => (
          <li data-reveal>
            <span class="num">{i + 1}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
