---
const services = [
  {
    title: "Coding agents for regulated teams",
    body: "A focused kickoff that gets your developers productive with Claude Code, Codex or Cursor, inside the guardrails your compliance team needs. It covers workflows, review rules, repo setup and a shared playbook.",
    tags: ["Kickoff", "Team enablement"],
  },
  {
    title: "Agent-ready products",
    body: "A fixed-scope sprint that makes your product usable by AI agents, with a clean public API, an MCP server, permissions and audit logs, so assistants can work with your data safely.",
    tags: ["Sprint", "MCP", "API"],
  },
  {
    title: "Agent pilots",
    body: "One real workflow, automated end to end and running in production within weeks, with the checks that make it trustworthy. You see the result before committing to more.",
    tags: ["Pilot", "Production"],
  },
  {
    title: "Ongoing partnership",
    body: "A standing engagement for teams that want a senior engineer on call. That means architecture reviews, agent setups that keep up with the tools, and a second pair of eyes on anything that has to be right.",
    tags: ["Retainer"],
  },
];
---

<section class="services shell" id="services">
  <div class="services-head">
    <p class="eyebrow" data-reveal><span>03</span>Services</p>
    <h2 class="h-display" data-reveal>Four ways to work together.</h2>
    <p class="services-intro" data-reveal>
      Fixed scope, clear outcomes, and a senior engineer doing the work.
    </p>
  </div>
  <div class="cards">
    {
      services.map(({ title, body, tags }, i) => (
        <article class="card" data-reveal>
          <span class="card-idx">{String.fromCharCode(65 + i)}</span>
          <h3>{title}</h3>
          <p>{body}</p>
          <ul class="chips">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
