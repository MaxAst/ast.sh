---
const links = [
  { href: "https://github.com/maxast", label: "GitHub" },
  { href: "https://www.linkedin.com/in/maximilianast", label: "LinkedIn" },
  { href: "https://x.com/maxi4st", label: "X" },
];
---

<section class="contact" id="contact">
  <div class="shell">
    <p class="eyebrow" data-reveal><span>06</span>Contact</p>
    <h2 class="contact-title" data-reveal>Building something that has to be <em>right?</em></h2>
    <div class="contact-row" data-reveal>
      <a class="contact-mail" href="mailto:max@ast.sh">max@ast.sh <span class="arr">&rarr;</span></a>
      <ul class="links">
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
